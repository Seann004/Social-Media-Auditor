PORT=3000
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Groq Llama Integration
GROQ_API_KEY=your_groq_api_key
# Model for the general AI features (checklist generation, chat).
GROQ_MODEL=llama-3.1-8b-instant
# Model that matches items across guidelines. It has its own setting, separate from GROQ_MODEL.
# It must be a model your Groq account can use and that supports JSON mode.
MAPPING_GROQ_MODEL=openai/gpt-oss-120b

# Brevo transactional email (project assignment notifications)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email

# Secret used to sign API auth tokens (login and the AI evidence routes).
# Minimum 32 characters; the AI evidence feature turns off if it is shorter. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# AI evidence assessment
# Model for the evidence assessor. It needs reasoning_effort and JSON mode support.
EVIDENCE_GROQ_MODEL=openai/gpt-oss-120b
# Service-role key: backend only, never in the frontend, logs or prompts.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Optional: connect to a hosted browser instead of starting Chromium locally.
BROWSER_WS_ENDPOINT=
# Optional: comma-separated hosts the capture may reach despite being private (e.g. a local demo site).
EVIDENCE_ALLOWED_PRIVATE_HOSTS=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts test-account passwords. Backend only; changing it makes saved passwords unreadable.
EVIDENCE_SECRET_KEY=
# Optional: how many evidence runs one project may start in 24 hours. Default 5, at most 100. Protects AI cost.
EVIDENCE_MAX_RUNS_PER_DAY=

# Set to off to skip the second look the app checks give each yes/no claim (saves a small call per claim, but more wrong claims get through).
# EVIDENCE_VERIFY_CLAIMS=on

# Meaning-based search for linking and page evidence. Both features use word matching only without a key.
# Free key from Google AI Studio (aistudio.google.com/apikey). Text sent: guideline items and public page passages only.
# GEMINI_API_KEY=
# Optional: EMBEDDING_MODEL=gemini-embedding-001, EMBEDDING_DIMENSIONS=768. EMBEDDINGS=off switches it off.
# Hugging Face's hosted API now needs paid credits (HTTP 402), so HF_API_TOKEN is not recommended.
